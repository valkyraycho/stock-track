# Copy this file to .env.local and paste your free Finnhub API key.
# Get one at https://finnhub.io/ — the free tier includes US stock WebSocket trades.
#
# NOTE: Variables prefixed with VITE_ are exposed to the client bundle.
# For a deployed static site, anyone viewing the site can read this value,
# which is why .env.local is gitignored. On GitHub Pages the app will
# prompt each visitor for their own key instead.
VITE_FINNHUB_API_KEY=
